# ── Contentstack (system of record) ─────────────────────────────
# Stack API key (Settings > Stack)
CONTENTSTACK_API_KEY=blt00000000000000
# Management token with read/write on content types + entries (Settings > Tokens > Management Tokens)
CONTENTSTACK_MANAGEMENT_TOKEN=cs00000000000000000000
# Stack region — only set for non-NA stacks. One of: na | eu | au | azure-na | azure-eu | gcp-na | gcp-eu.
# Maps to the correct Contentstack API host. Default: na. Used by `npm run sync:models`.
CONTENTSTACK_REGION=na
# Delivery environment name (e.g. "development" | "production")
CONTENTSTACK_ENVIRONMENT=development
# Shared secret used to verify the inbound webhook. `app/api/webhook/route.ts` compares
# this to the value of the custom header `x-contentstack-webhook-secret` on the inbound
# request. The webhook created by `npm run sync:webhook` sends exactly that header with
# this value, so the two MUST match (set the same value here and in the deployed app).
CONTENTSTACK_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public URL of the deployed `/api/webhook` endpoint, e.g. https://<app>.vercel.app/api/webhook.
# Required by `npm run sync:webhook` (create/update the Contentstack webhook). Runtime-only;
# leave unset until the app is deployed and you know its URL. See docs/webhook-setup.md.
WEBHOOK_TARGET_URL=https://your-app.vercel.app/api/webhook
# Optional: override the webhook name (idempotency key) and trigger channel used by
# `npm run sync:webhook`. Defaults shown. Trigger = a blog_post entry publishes successfully.
# WEBHOOK_NAME=one-post-pipeline
# WEBHOOK_TRIGGER=content_types.blog_post.entries.publish.success

# ── Deep reasoning provider (transcreation + fact-check) ─────────
# Selects the reasoning implementation behind the seam in lib/eve.ts.
#   aisdk = run reasoning in-process via the Vercel AI SDK (DEFAULT; builds+runs).
#   eve   = delegate reasoning to a deployed Vercel eve agent (https://eve.dev).
REASONING_PROVIDER=aisdk

# ── AI SDK path (used when REASONING_PROVIDER=aisdk) ─────────────
# Routes models through Vercel AI Gateway (see lib/eve.ts), which gives provider failover.
# Needed for LOCAL / non-Vercel runs. On Vercel deployments this can be OMITTED — the SDK
# authenticates automatically via OIDC (VERCEL_OIDC_TOKEN). Runtime-only; builds without it.
AI_GATEWAY_API_KEY=vck_000000000000000000000000
# Optional: override the model in provider/model form (defaults to openai/gpt-4o in lib/eve.ts).
# Swap providers just by changing this, e.g. anthropic/claude-sonnet-4.6.
AI_MODEL=openai/gpt-4o

# ── Vercel eve path (used when REASONING_PROVIDER=eve) ───────────
# Base URL of your deployed eve agent's HTTP channel (npx eve deploy prints this;
# local dev defaults to http://127.0.0.1:2000). Required when provider=eve.
EVE_AGENT_URL=https://your-agent.vercel.app
# Shared secret the eve agent's channel verifies (Authorization: Bearer <secret>).
# NOTE: on Vercel, eve routes models via AI Gateway using OIDC — no provider key needed there.
EVE_TRIGGER_SECRET=change-me-to-a-long-random-string

# ── Slack (the one real external push) ───────────────────────────
# Bot token from your Slack app (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
# Target channel id (right-click channel > View channel details > bottom)
SLACK_CHANNEL_ID=C0000000000
