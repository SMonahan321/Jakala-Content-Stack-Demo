{
  "content_type": {
    "title": "Blog Post",
    "uid": "blog_post",
    "description": "Source article authored by a human. System of record for a campaign.",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title",
      "sub_title": []
    },
    "schema": [
      {
        "display_name": "Title",
        "uid": "title",
        "data_type": "text",
        "mandatory": true,
        "unique": true,
        "field_metadata": { "_default": true }
      },
      {
        "display_name": "Summary",
        "uid": "summary",
        "data_type": "text",
        "mandatory": false,
        "field_metadata": { "description": "Short dek / social-ready summary." }
      },
      {
        "display_name": "Body",
        "uid": "body",
        "data_type": "text",
        "mandatory": true,
        "field_metadata": { "multiline": true, "description": "Full source article body." }
      },
      {
        "display_name": "Key Claims",
        "uid": "key_claims",
        "data_type": "text",
        "multiple": true,
        "mandatory": false,
        "field_metadata": {
          "description": "Author-declared, source-of-truth medical claims used by the Fact-Checker."
        }
      },
      {
        "display_name": "Featured Image",
        "uid": "featured_image",
        "data_type": "file",
        "mandatory": false,
        "multiple": false,
        "extensions": [],
        "field_metadata": {
          "description": "Hero image for the post; source asset for channel image-crop specs.",
          "rich_text_type": "standard"
        }
      },
      {
        "display_name": "Demo: Bypass Compliance",
        "uid": "demo_bypass_compliance",
        "data_type": "boolean",
        "mandatory": false,
        "field_metadata": {
          "description": "DEMO ONLY — when true, transcreation carries source claims verbatim so the fact-checker can flag them. Never enable on real content."
        }
      }
    ]
  }
}
